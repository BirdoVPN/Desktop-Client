# Local env files
.env
.env.local
.env.*.local

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/

# OS files
.DS_Store
Thumbs.db

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

