{
  "identifier": "default",
  "description": "Birdo VPN main window: the app commands the UI calls (MR-2011) and the plugin permissions it uses",
  "windows": ["main"],
  "permissions": [
    "allow-login",
    "allow-login-anonymous",
    "allow-register-anonymous",
    "allow-native-oauth-login",
    "allow-logout",
    "allow-get-auth-state",
    "allow-verify-2fa",
    "allow-delete-account",
    "allow-deletion-preflight",
    "allow-export-user-data",
    "allow-end-expired-session",
    "allow-connect-vpn",
    "allow-disconnect-vpn",
    "allow-get-vpn-status",
    "allow-get-vpn-stats",
    "allow-quick-connect",
    "allow-reapply-vpn-settings",
    "allow-get-admin-status",
    "allow-get-servers",
    "allow-ping-server",
    "allow-get-settings",
    "allow-save-settings",
    "allow-set-autostart",
    "allow-reset-settings",
    "allow-set-crash-reports-enabled",
    "allow-record-consent",
    "allow-delete-logs",
    "allow-get-killswitch-status",
    "allow-set-killswitch-live",
    "allow-list-installed-apps",
    "allow-get-app-version",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-get-required-update",
    "allow-take-update-resume",
    "allow-get-third-party-notices",
    "allow-get-subscription-status",
    "allow-get-usage-stats",
    "allow-get-client-config",
    "allow-connect-multi-hop",
    "allow-get-port-forwards",
    "allow-create-port-forward",
    "allow-delete-port-forward",
    "allow-redeem-voucher",
    "allow-run-speed-test-command",
    "allow-check-biometric-available",
    "allow-set-biometric-enabled",
    "allow-authenticate-biometric",
    "allow-take-pending-deep-link",
    "allow-show-main-window",
    "allow-copy-sensitive",
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-decorations",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://birdo.app" },
        { "url": "https://birdo.app/*" },
        { "url": "https://auth.birdo.app" },
        { "url": "https://auth.birdo.app/*" },
        { "url": "https://dashboard.birdo.app" },
        { "url": "https://dashboard.birdo.app/*" }
      ]
    },
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "process:default",
    "deep-link:default",
    "dialog:default",
    "dialog:allow-open"
  ]
}
